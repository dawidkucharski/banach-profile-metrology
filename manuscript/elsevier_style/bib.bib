journal = {Chest},
month = {apr},
number = {4},
pages = {1146--61},
pmid = {10767253},
title = {{Office spirometry for lung health assessment in adults: A consensus statement from the National Lung Health Education Program.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/10767253},
volume = {117},
year = {2000}
}
