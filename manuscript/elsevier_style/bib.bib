keywords = {a newly developed practical,abstract,fizeau interferometer,for coordinate,in industry,in particular,interferometry is described in,means of stitching,sphere,spheres,spheres are widely used,sphericity,sphericity measurement system by,stitching technique,such as reference sphere,this paper,used in metrological applications,with stem are usually},
