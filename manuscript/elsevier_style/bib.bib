journal = {Experimental Mechanics},
keywords = {Dynamic necking,Notch,Tensile tests,Weakest link},
month = {jul},
number = {6},
pages = {1099--1109},
title = {{Dynamic Necking of Notched Tensile Bars: An Experimental Study}},
url = {http://link.springer.com/10.1007/s11340-014-9860-8},
volume = {54},
year = {2014}
}
@article{Dilhaire2000,
abstract = {This paper deals with the optical measurement of strain in electronic power devices under normal operating conditions. This non-contact and non-invasive method called shearography is based upon speckle interferometry. The technique developed produces images of normal displacement gradient of devices. Numerical processing allows the determination of the surface displacement and its related strain. The main advantages of the measuring tool are to be a simple optical set-up, to be very robust with a good sensitivity and to measure directly strain. Therefore, it is well suited to fit into an industrial environment. {\textcopyright} 2000 Elsevier Science Ltd. All rights reserved.},
author = {Dilhaire, S. and Jorez, S. and Cornet, A. and {Pati{\~{n}}o Lopez}, L.D. and Claeys, W.},
