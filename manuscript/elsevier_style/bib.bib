@article{Taillade2013a,
abstract = {A shearographic method is proposed that (i) allows bonding defects (delamination or adhesive disbonds) between concrete structures and externally bonded fiber-reinforced polymer (FRP) reinforcements to be detected, (ii) assesses the width of these defects, and (iii) evaluates the quality of the adhesive bond in the case of partial delamination, damage or poor properties of the polymer adhesive. The performance of this method is first demonstrated on laboratory specimens containing calibrated defects, i.e. non-adherent polytetrafluoroethylene discs placed at the concrete-to-FRP interface. Then, a case study illustrates the interest of such method for on-site routine inspections of FRP strengthened structures. {\textcopyright} 2013 Woodhead Publishing Limited. All rights reserved.},
