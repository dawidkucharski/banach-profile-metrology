@phdthesis{M.Wos_thesis_2019,
abstract = {In this work, a new method of sperm morphology evaluation is presented by using an algorithm, designed to analyze images from a digital holographic microscope. The algorithm was written in the R language, which is part of a free software environment, meaning that it is openly accessible for usage and modification. The purpose of the program is to isolate sperm heads from the image and then determine their length and width. In addition, a height profile and a three-dimensional model are created for each head. The designed algorithm was used to analyze 120 images from a digital holographic microscope and resulted in a recognition rate of 97% of all sperm heads. The obtained lengths and widths of the head were compared with the results of manually taken measurements on the same set of images. The Student's T-test showed that there are significant differences between the two methods of measurement.},
author = {Wo{\'{s}}, Magdalena},
pages = {58},
school = {Poznan University of Technology},
title = {{Determination of sperm head morphology by computer analysis of holographic images}},
type = {Master's Thesis},
year = {2019}
}
