journal = {Journal of Biomedical Engineering},
keywords = {Computer simulation,insulin dosage adjustment,physiological model,type 1 diabetes mellitus},
month = {may},
number = {3},
pages = {235--242},
title = {{A physiological model of glucose-insulin interaction in type 1 diabetes mellitus}},
url = {https://linkinghub.elsevier.com/retrieve/pii/014154259290058S},
volume = {14},
year = {1992}
