file = {:Users/DawidKucharski/Library/Application Support/Mendeley Desktop/Downloaded/Wang et al. - 2020 - Measurement of Surface Velocity in a 150 mm × 1270 mm Slab Continuous-Casting Mold.pdf:pdf},
issn = {2075-4701},
journal = {Metals},
keywords = {continuous-casting mold,nail-board experiment,numerical simulation,surface velocity},
