@inproceedings{Waldner1999,
abstract = {In this manuscript we present the development of an integrated shearography system that is able to measure the three-dimensional deformation of an object surface. In order to determine all six displacement derivatives that may contribute to shearography results, six measurements with three different sensitivity directions and two shear directions have to be performed. The realized system is able to perform this measurement sequence in an automated way. The shearography head for observation of the object is based on a Michelson interferometer, where one mirror can be rotated about two axes by motors in order to effect the image shear. Three illumination modules - consisting of a laser, a shutter and a spatial filter - are attached to the shearography head to produce the three sensitivity directions. For pure out-of-plane measurements, a simplified set-up with only one illumination module can be assembled. The developed system is compact and portable, and is therefore suited for applications outside the optical laboratory. After a detailed description of the design process, first measurements for validating the system are presented.},
author = {Waldner, Stephan and Brem, Stefan},
booktitle = {Interferometry '99: Applications},
doi = {10.1117/12.357771},
editor = {Jueptner, Werner P. O. and Patorski, Krzysztof},
file = {:Users/DawidKucharski/Library/Application Support/Mendeley Desktop/Downloaded/Waldner, Brem - 1999 - Compact shearography system for the measurement of 3D deformation.pdf:pdf},
keywords = {design process,nondestructive testing,speckle interferometry,strain measurement},
month = {aug},
number = {1},
pages = {141--148},
title = {{Compact shearography system for the measurement of 3D deformation}},
