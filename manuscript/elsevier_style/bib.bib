file = {:Users/DawidKucharski/Library/Application Support/Mendeley Desktop/Downloaded/Braga et al. - 2016 - Phase-shifting of correlation fringes created by image processing as an alternative to improve digital shearograph.pdf:pdf},
issn = {00304018},
journal = {Optics Communications},
keywords = {Digital speckle pattern shearing interferometry,Phase-shift algorithm,Piezoelectric transducer,Speckle interferometry},
month = {dec},
pages = {114--123},
title = {{Phase-shifting of correlation fringes created by image processing as an alternative to improve digital shearography}},
url = {http://linkinghub.elsevier.com/retrieve/pii/S0030401816304965 papers3://publication/doi/10.1016/j.optcom.2016.06.001},
volume = {380},
year = {2016}
}
