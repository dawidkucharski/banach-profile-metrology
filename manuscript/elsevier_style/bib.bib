@inproceedings{Stepien2010,
abstract = {Today cylindricity is usually assessed basing on radius change measurements. The most important advantage of this method is their high accuracy reaching 0.1 $\mu$m. Unfortunately, it requires accurate levelling and alignment of a workpiece on a measuring table. Moreover, it is suitable for measurement of elements with small dimensions. This is quite inconvenient, because industrial control needs to be conducted directly on a machine tool or on an industrial measuring stand, particularly in the case of series production. Modern industry requires that measurements should be carried out continuously and directly on a machine tool, which allows immediate correction. The V-block methods seem to meet all these expectations, yet they have been employed for approximate measurement of form profiles only. Therefore authors developed the concept of cylindricity measurements by the V-block method. Results of statistical calculations show that the result of the cylindricity deviation measurement taken by means of the proposed method lies within the range 19% in relation to result obtained by the highly accurate radial method (for assumed probability level P=0,95). Problem about the V-block method is that there are many sources of errors (errors of the V-blocks, out-of straightness of the slide, errors of the sensor). All these factors can influence measurement result and increase measurement uncertainty. Authors investigated potential sources of errors and developed procedures allowing compensation of influence of most significant ones. The paper provides results of experimental research on an analysis and compensation of main sources of errors in cylindricity measurements by the V-block method.},
address = {Politechnika Swietokrzyska w Kielcach, Kielce, Poland},
author = {St{\c{e}}pie{\'{n}}, Krzysztof and Janecki, Dariusz and Adamczak, Stanis{\l}aw},
booktitle = {10th International Symposium on Measurement and Quality Control 2010, ISMQC 2010},
