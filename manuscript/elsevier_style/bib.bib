journal = {Bulletin of the Polish Academy of Sciences: Technical Sciences},
keywords = {Morphological filtration,Stratified textures,Surface topography},
number = {1},
pages = {107--113},
title = {{Morphological filtration of two-process profiles}},
volume = {67},
year = {2019}
