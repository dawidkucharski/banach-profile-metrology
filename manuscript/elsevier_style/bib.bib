@article{Colomb2010b,
abstract = {A recurrent problem in microscopy is the finite depth-of-focus linked to the NA of microscope objectives. Digital holographic microscopy (DHM) has the unique feature of being able to numerically change the focus from a single hologram without the need of moving the sample. Extended depth of focus of amplitude images has been demonstrated, but it has marginal interest for the metrological application of DHM that needs the topography. In this Letter, we demonstrate that DHM is able to provide not only extended depth-of-focus amplitude images but extended focused complex data from which the topography is computed. For this purpose, reflection and transmission measurements on micro-optics (microlens and retroreflector) performed by using standard reconstruction or the extended focused complex data are compared. These experiments demonstrate that DHM measures, from a single hologram acquisition, the accurate sample topography on a numerically increased depth-of-focus.},
author = {Colomb, Tristan and Pavillon, Nicolas and K{\"{u}}hn, Jonas and Cuche, Etienne and Depeursinge, Christian and Emery, Yves},
doi = {10.1364/OL.35.001840},
file = {:Users/DawidKucharski/Library/Application Support/Mendeley Desktop/Downloaded/Colomb et al. - 2010 - Extended depth-of-focus by digital holographic microscopy.pdf:pdf},
issn = {0146-9592},
journal = {Optics Letters},
month = {jun},
number = {11},
pages = {1840},
title = {{Extended depth-of-focus by digital holographic microscopy}},
url = {https://www.osapublishing.org/abstract.cfm?URI=ol-35-11-1840},
volume = {35},
year = {2010}
}
@article{Sandras2009,
abstract = {To characterize the shape, the quality, and the roughness of microshells, typically used technologies are scanning electron microscopy, scanning interferometric microscopy, or atomic force microscopy. One of the drawbacks of these techniques is that they are generally slow because of their scanning process. Digital holographic microscopy technology is an innovation that can offer ability adapted to these studies. It captures holograms instead of intensity images, as done by conventional microscopes. The holograms are then digitally interpreted (10 per second) to reconstruct a double image, one for the intensity and another one for the phase. Using a rotation axis, the bump counting for the complete microshell surface is possible with a very high speed. Using an image stitching software, mapping can be done in a few minutes. Wavelets such as "Mexican hat" are used to model the bumps. Each bump can then be characterized on the map by its position, diameter, and height.},
author = {Sandras, F. and Hermerel, C. and Choux, A. and M{\'{e}}rillot, P. and Pin, G. and Jeannot, L.},
doi = {10.13182/FST09-A7416},
file = {:Users/DawidKucharski/Library/Application Support/Mendeley Desktop/Downloaded/Sandras et al. - 2009 - Characterization of the Microshell Surface Using Holographic Measurements.pdf:pdf},
issn = {1536-1055},
journal = {Fusion Science and Technology},
keywords = {Digital holography,Surface defect mapping,Wavelet analysis},
month = {may},
number = {4},
pages = {389--398},
title = {{Characterization of the Microshell Surface Using Holographic Measurements}},
url = {https://www.tandfonline.com/doi/full/10.13182/FST09-A7416},
volume = {55},
year = {2009}
}
@phdthesis{Kucharskiphd_2015,
abstract = {This thesis is dedicated to the design and implementation of a system for interferometric, non-contact shape deviation measurements with roundness example. Thesis presents issues of contact and non-contact measurement methods currently used for deviation shape measurements. Construction steps and implementation of an optical system based on laser interferometry for shape deviation measurements was shown. Analysis of the knowledge state in the area of modern methods for measuring shape deviations and metrology equipment for it, shows that there are many different methods and systems for shape deviation measurements, but not so much systems using laser interferometry. These facts led to a thesis goal as follows: Constructing an optical interferometric system for shape deviation measurements with nanometric resolution. In light of the subject state analysing of the application of laser interferometry measurements in technical metrology was found that this technic is still dynamique develope. There is a wide spectrum of undeveloped knowledge of optics implemented in the area of classical technical metrology. This thesis is attempt to broaden the knowledge of the optical methods and equipment used in the technical metrology for shape deviation measurements, which use the phenomenons has not fully used and described in the field of technical metrology. This dissertation contains a description of all the important steps of the construction of the non-contact interferometric system for shape deviation measurements. An important part of the work was to apply the knowledge from the field of physics, including in particular the linear optics and interferometry. This thesis attempts to unify knowledge of the optical shape deviation measurement methods on the example of the roundness. As a result of research a functional system for non-contact optical shape deviation measurements with roundness example was constructed. Also the principle of measuring with device was developed. Software of the device was prepared and potential for expansion system was shown. This thesis presents the possibility to adapt the constructed device for measuring other quantities in a optical non-contact metrology.},
author = {Kucharski, Dawid},
pages = {193},
school = {Poznan University of Technology},
title = {{Interferometric system for non-tactile shape deviation measurements}},
type = {PhD thesis},
year = {2015}
}
@article{D.Gobar1948,
abstract = {The theory of the interaction of the double layers has been reviewed in relation to the stability of lyophobic colloids. It is concluded that the interaction must be associated with an increase of the free energy, leading to a repulsion between the particles. The repulsive potential calculated from a consideration of the free energy for certain special cases has been combined with the London-van der Waals attractive potential calculated by Hamaker to obtain curves of potential vs. distance. Predictions based on these curves appear to agree well with various experimental data. For example, the influence of electrolyte concentration and of the valencies of the ions on flocculation is satisfactorily explained in terms of the theory, although many complicated phenomena remain to be correlated with it.},
