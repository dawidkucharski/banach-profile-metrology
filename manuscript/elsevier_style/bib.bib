isbn = {9781624103032},
issn = {0218-5385},
journal = {Asia Pacific Journal of Social Work and Development},
number = {1},
pages = {134--134},
pmid = {15067778},
title = {{Manuscript Guidelines}},
url = {http://www.tandfonline.com/doi/abs/10.1080/21650993.1999.9755816},
volume = {9},
year = {1999}
}
