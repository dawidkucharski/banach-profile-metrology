keywords = {Depletion,Physeter,Population,Sperm whale,Whaling},
month = {jan},
pages = {295--304},
title = {{Estimates of the current global population size and historical trajectory for sperm whales}},
url = {http://www.int-res.com/abstracts/meps/v242/p295-304/ papers3://publication/doi/10.3354/meps242295},
volume = {242},
year = {2002}
}
