keywords = {Doppler global velocimetry (DGV),laser Doppler anemometry (LDA),laser Doppler velocimetry (LDV),laser transit anemometry (LTA),laser-two-focus (L2F),optical fibre,particle imaging velocimetry (PIV),planar Doppler velocimetry (PDV)},
