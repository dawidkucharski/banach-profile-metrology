pages = {235--238},
pmid = {14604836},
publisher = {American Thoracic Society},
title = {{Repeatability of Spirometry in 18,000 Adult Patients}},
url = {http://www.atsjournals.org/doi/abs/10.1164/rccm.200204-347OC},
volume = {169},
year = {2004}
}
@article{Schneider2009,
abstract = {BACKGROUND: To evaluate the sensitivity, specificity and predictive values of spirometry for the diagnosis of chronic obstructive pulmonary disease (COPD) and asthma in patients suspected of suffering from an obstructive airway disease (OAD) in primary care.\n\nMETHODS: Cross sectional diagnostic study of 219 adult patients attending 10 general practices for the first time with complaints suspicious for OAD. All patients underwent spirometry and structured medical histories were documented. All patients received whole-body plethysmography (WBP) in a lung function laboratory. The reference standard was the Tiffeneau ratio (FEV1/VC) received by the spirometric maneuver during examination with WBP. In the event of inconclusive results, bronchial provocation was performed to determine bronchial hyper-responsiveness (BHR). Asthma was defined as a PC20 fall after inhaling methacholine concentration < or = 16 mg/ml.\n\nRESULTS: 90 (41.1%) patients suffered from asthma, 50 (22.8%) suffered from COPD, 79 (36.1%) had no OAD. The sensitivity for diagnosing airway obstruction in COPD was 92% (95%CI 80-97); specificity was 84% (95%CI 77-89). The positive predictive value (PPV) was 63% (95%CI 51-73); negative predictive value (NPV) was 97% (95%CI 93-99). The sensitivity for diagnosing airway obstruction in asthma was 29% (95%CI 21-39); specificity was 90% (95%CI 81-95). PPV was 77% (95%CI 60-88); NPV was 53% (95%CI 45-61).\n\nCONCLUSION: COPD can be estimated with high diagnostic accuracy using spirometry. It is also possible to rule in asthma with spirometry. However, asthma can not be ruled out only using spirometry. This diagnostic uncertainty leads to an overestimation of asthma presence. Patients with inconclusive spirometric results should be referred for nitric oxide (NO) - measurement and/or bronchial provocation if possible to guarantee accurate diagnosis.},
author = {Schneider, Antonius and Gindner, Lena and Tilemann, Lisa and Schermer, Tjard and Dinant, Geert Jan and Meyer, Franz Joachim and Szecsenyi, Joachim},
doi = {10.1186/1471-2466-9-31},
file = {:Users/DawidKucharski/Library/Application Support/Mendeley Desktop/Downloaded/Schneider et al. - 2009 - Diagnostic accuracy of spirometry in primary care.pdf:pdf},
isbn = {1471-2466 (Electronic)\n1471-2466 (Linking)},
issn = {14712466},
journal = {BMC Pulmonary Medicine},
keywords = {Adult,Aged,Asthma,Asthma: diagnosis,Asthma: physiopathology,Chronic Obstructive,Chronic Obstructive: diagnosis,Chronic Obstructive: physiopath,Cross-Sectional Studies,Diagnostic Errors,Diagnostic Errors: prevention & control,Female,Forced Expiratory Volume,Forced Expiratory Volume: physiology,Humans,Male,Middle Aged,Plethysmography,Predictive Value of Tests,Pulmonary Disease,Sensitivity and Specificity,Spirometry,Spirometry: standards,Whole Body},
month = {jul},
pages = {e31. doi:10.1186/1471--2466--9--31},
pmid = {19591673},
publisher = {BioMed Central},
title = {{Diagnostic accuracy of spirometry in primary care}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/19591673 http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=PMC2714498 http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=2714498&tool=pmcentrez&rendertype=abstract},
volume = {9},
