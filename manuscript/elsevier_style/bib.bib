@article{Hosoe1991,
abstract = {A practical method for measuring displacement with a newly developed laser interferometric system is proposed. The new system has a simplified optical layout. fewer optical elements, and a shortened pass. As a result, the thermal drift and non-linearity of the displacement measurement have been decreased in both the bi-frequency heterodyne system and the fringe- counting system. In addition, simplified electrical fringe counting logic has shortened the time needed to obtain the measured value without losing accuracy This method achieved (i) sub-nanometer resolution (0.6 nm/ws). (ii) high stability (2.5nm/day). (iii) high linearity (less than 1 LSE), and (iv) high following speed (more than 1000mm/s).},
